# Everything the packaged extension does not need at run time.
.github/**
.vscode/**
.vscode-test/**
src/**
test/**
node_modules/**
assets/screenshots/**
media/viewer.js
esbuild.js
tsconfig.json
.editorconfig
.gitignore
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
SUPPORT.md
CLAUDE.md
**/*.map
**/*.ts
*.vsix
# KaTeX woff/ttf fallbacks: the webview uses woff2 only (see esbuild.js); old builds may have left them in dist/fonts.
dist/fonts/*.woff
dist/fonts/*.ttf
